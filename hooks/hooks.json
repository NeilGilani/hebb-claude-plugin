{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hebb_hooks.py", "session", "${user_config.hebb_key}"], "timeout": 15}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hebb_hooks.py", "inject", "${user_config.hebb_key}"]}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hebb_hooks.py", "guard", "${user_config.hebb_key}"]}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hebb_hooks.py", "observe", "${user_config.hebb_key}"]}]}
    ],
    "PostToolUseFailure": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hebb_hooks.py", "observe", "${user_config.hebb_key}"]}]}
    ]
  }
}
